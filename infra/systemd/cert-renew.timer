# Коли запускати: двічі на день + випадкова затримка до години.
# Увага: systemd не розуміє коментарі в кінці рядка — лише на окремому рядку.
[Unit]
Description=Перевірка HTTPS-сертифіката двічі на день

[Timer]
OnCalendar=*-*-* 03,15:17:00
RandomizedDelaySec=1h
# Якщо сервер був вимкнений у момент запуску — виконати після увімкнення
Persistent=true

[Install]
WantedBy=timers.target
